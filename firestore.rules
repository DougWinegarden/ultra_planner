rules_version = '2';

// Ocean Lists security rules.
//
// Deploy with:   firebase deploy --only firestore:rules
//
// Everything is deny-by-default. A path that is not matched below is closed, so
// adding a new collection means adding a rule for it here too.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A document belongs to the caller when its ownerId is their uid.
    function owns(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    // Task lists. The app queries these with where('ownerId', '==', uid), which
    // is what makes the read rule satisfiable for a collection query.
    match /lists/{listId} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);
      // Both sides are checked so a list cannot be handed to another account.
      allow update: if owns(resource.data) && owns(request.resource.data);
    }

    // Individual tasks, each carrying the id of its parent list.
    match /tasks/{taskId} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }

    // Per-user rate limit counters for the Quackers functions. Written only by
    // the Admin SDK inside those functions, which bypasses these rules, so no
    // client may read or reset its own allowance.
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // Player profiles: username, initials, level, XP, prestige.
    //
    // Readable by any signed-in user, because that is what the leaderboard
    // shows. Written only by the progress Cloud Functions -- the XP trigger,
    // setUsername and prestige -- so no client can raise its own level or set a
    // name that did not come from the approved word lists.
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Which player holds each username, so names stay unique. Server only.
    match /usernames/{nameKey} {
      allow read, write: if false;
    }

    // One record per task that has paid out XP, so a task cannot pay twice.
    // Server only: a client that could delete these could farm the same task.
    match /users/{userId}/xpAwards/{taskId} {
      allow read, write: if false;
    }

    // Encrypted Gemini API keys.
    //
    // Denied to every client, including the owner. The key is written only by
    // saveGeminiKey and read only by askQuackers, both via the Admin SDK. A
    // client that could read this would get ciphertext rather than a usable
    // key, but there is no reason to hand it out at all -- the app asks
    // quackersStatus whether a key exists instead.
    match /users/{userId}/private/{document} {
      allow read, write: if false;
    }

  }
}
